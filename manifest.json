{
  "name": "Ferramenta Fusion DEV",
  "version": "1.23",
  "manifest_version": 3,
  "permissions": [
    "storage"
  ],
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/fusion/*"
      ],
      "run_at": "document_start",
      "js": [
        "fusion-compat.js"
      ]
    },
    {
      "matches": [
        "*://*/fusion/*"
      ],
      "js": [
        "script.js"
      ],
      "css": [
        "menu.css"
      ]
    }
  ],
  "action": {
    "default_title": "Fusion DEV - LOCAL",
    "default_popup": "popup.html"
  }
}